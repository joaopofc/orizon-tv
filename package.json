{
  "name": "orizon-tv",
  "version": "1.0.1",
  "description": "Orizon TV - Player IPTV Moderno para Desktop e Notebook",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite",
    "dev": "concurrently -k \"node server/index.js\" \"vite\"",
    "electron:dev": "concurrently -k \"node server/index.js\" \"vite\" \"wait-on tcp:3001 tcp:5173 && node electron/start.cjs\"",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "hls.js": "^1.5.18",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.orizontv.app",
    "productName": "Orizon TV",
    "copyright": "Copyright © 2026 Orizon TV",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "server/**/*",
      "dist/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Orizon TV"
    }
  }
}
